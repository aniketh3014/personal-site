---
import { getCollection } from "astro:content";
import dayjs from "dayjs";

const entries = await getCollection("experience");
// Current roles first, then by end date; ties keep the file's order.
// Same order as the resume PDF (scripts/build-resume.mjs).
entries.sort((a, b) =>
  (b.data.end ?? "9999-99").localeCompare(a.data.end ?? "9999-99")
);

const fmt = (ym: string) => dayjs(`${ym}-01`).format("MMM YYYY");
---

<ol class="not-prose space-y-8">
  {
    entries.map(({ data }) => (
      <li>
        <h3 class="text-lg font-semibold">
          {data.role} ·{" "}
          {data.company_url ? (
            <a href={data.company_url} class="hover:text-accent underline">
              {data.company}
            </a>
          ) : (
            data.company
          )}
        </h3>
        <p class="text-muted-foreground text-sm">
          {fmt(data.start)} – {data.end ? fmt(data.end) : "Present"}
          {data.location && ` · ${data.location}`}
        </p>
        <ul class="marker:text-accent mt-2 list-disc space-y-1 ps-5">
          {data.highlights.map(item => (
            <li>{item}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>
