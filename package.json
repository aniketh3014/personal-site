{
  "name": "aniketghosh-in",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check:csp": "node scripts/check-csp.mjs",
    "crosspost": "node scripts/crosspost.mjs",
    "lint:md": "markdownlint-cli2",
    "check:links": "linkinator dist --config linkinator.config.json",
    "check:lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "check": "npm run format:check && npm run lint && npm run lint:md && npm run build && npm run check:links && npm run check:csp && npm run check:lighthouse",
    "resume": "node scripts/build-resume.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.3",
    "dayjs": "^1.11.21",
    "lodash.kebabcase": "^4.1.1",
    "rehype-callouts": "^2.2.0",
    "rehype-mermaid": "^3.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.2",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@lhci/cli": "^0.15.1",
    "@shikijs/transformers": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^2.1.1",
    "linkinator": "^8.1.0",
    "markdownlint-cli2": "^0.24.0",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
